# Kopioi nimella /etc/holvi/salaisuudet.env, omistaja root:holvi, oikeudet 640.
# ALA koskaan commitoi oikeaa tiedostoa. Tama tiedosto sisaltaa vain paikkamerkkeja.

# GitHub: hienojakoinen token (fine-grained), vain luku -oikeudet tarvittaviin repoihin
GITHUB_TOKEN=

# Gmail: nama kirjoittaa holvi-kirjaudu-komento (ks. README), ala tayta kasin
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Telegram-halytykset estetyista pyynnoista ja vanhentuneista tunnuksista (valinnainen)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
