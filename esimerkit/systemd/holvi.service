[Unit]
Description=Holvi - tunnusvalittaja tekoalyagenteille
After=network-online.target
Wants=network-online.target

[Service]
User=holvi
Group=holvi
Environment=HOLVI_DIR=/etc/holvi
Environment=HOLVI_LOKI=/var/log/holvi/audit.log
# Kuuntele vain palvelimen omaa osoitetta, ei 0.0.0.0. Vaihda oma osoite.
Environment=HOLVI_HOST=192.0.2.2
Environment=HOLVI_PORT=8700
ExecStart=/opt/holvi/venv/bin/holvi
Restart=on-failure
RestartSec=5
# Kovennus (tarkista omalla koneella: systemd-analyze security holvi.service)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/log/holvi
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
